---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const siteOrigin = 'https://bwax.services';
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const {
  title = 'BWax Services | Brazilian Wax Epilation Technology & Insights',
  description = 'Explore the science, reliability, and best practices of Brazilian wax epilation. Professional insights on hair removal technology for smooth, lasting results.',
  ogImage = `${siteOrigin}/og-image.png`,
  canonical = new URL(pathname, siteOrigin).href,
} = Astro.props;

const siteName = 'BWax Services';
const twitterHandle = '@bwaxservices';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="K_toAo5wMIQO2aQtcE0cYZDN3952kAx0Re8RItc24Xo" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content={twitterHandle} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Theme color -->
    <meta name="theme-color" content="#c97d64" />
    <meta name="msapplication-TileColor" content="#c97d64" />

    <!-- Structured Data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": siteOrigin,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "BWax Services",
        "url": siteOrigin
      }
    })} />

    <!-- Structured Data: WebPage + Article-like for informational -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonical,
      "isPartOf": {
        "@type": "WebSite",
        "name": siteName,
        "url": siteOrigin
      },
      "about": {
        "@type": "Thing",
        "name": "Brazilian Wax Epilation",
        "description": "Hair removal method using warm or cold wax that extracts hair from the root, providing smooth skin for 3 to 4 weeks."
      },
      "datePublished": "2026-07-29",
      "dateModified": "2026-08-08",
      "inLanguage": "en-US"
    })} />

    <!-- Structured Data: FAQPage for key characteristics -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is wax epilation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wax epilation is a hair removal method that extracts hair from the root using warm or cold wax, providing smooth skin for 3 to 4 weeks. It is generally considered less painful than epilators because the discomfort is a short, sharp sensation rather than the continuous pinching caused by mechanical tweezers."
          }
        },
        {
          "@type": "Question",
          "name": "How long do results from Brazilian wax last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wax epilation provides smooth skin for 3 to 4 weeks. With consistent use, hair regrowth tends to become finer over time."
          }
        },
        {
          "@type": "Question",
          "name": "Is hard wax better for sensitive areas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Hard wax is ideal for sensitive areas like the bikini line and underarms because it adheres only to the hair, not the skin, reducing irritation."
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <slot />
  </body>
</html>
